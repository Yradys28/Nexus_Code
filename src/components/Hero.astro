<section id="inicio" class="relative overflow-hidden pt-28 pb-20 sm:pt-36 lg:pt-44 lg:pb-28">
	<!-- Fondos decorativos: rejilla técnica + resplandores -->
	<div class="bg-grid pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
	<div
		class="pointer-events-none absolute -top-32 left-1/2 h-[480px] w-[720px] -translate-x-1/2 rounded-full bg-[#372eab]/30 blur-[130px]"
		aria-hidden="true"
	>
	</div>
	<div
		class="pointer-events-none absolute bottom-0 right-0 h-72 w-72 rounded-full bg-[#8055da]/20 blur-[110px]"
		aria-hidden="true"
	>
	</div>

	<div class="relative mx-auto grid max-w-7xl items-center gap-14 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
		<!-- ===== Columna de contenido ===== -->
		<div class="text-center lg:text-left">
			<!-- Badging / tag superior con bordes iluminados -->
			<div class="mb-6 flex justify-center lg:justify-start">
				<span
					class="group inline-flex items-center gap-2 rounded-full border border-[#8055da]/40 bg-[#8055da]/10 px-4 py-1.5 text-xs font-medium tracking-wide text-white/80 backdrop-blur transition-all duration-300 hover:border-[#8055da] hover:shadow-[0_0_20px_-4px_rgba(128,85,218,0.7)]"
				>
					<span class="relative flex size-1.5">
						<span class="absolute inline-flex size-full animate-ping rounded-full bg-[#8055da] opacity-75"></span>
						<span class="relative inline-flex size-1.5 rounded-full bg-[#8055da]"></span>
					</span>
					[ BADGE / ETIQUETA DESTACADA ]
				</span>
			</div>

			<!-- Título principal con degradado -->
			<h1 class="font-display text-4xl leading-[1.1] font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
				[ INSERTAR TÍTULO ]
				<span class="text-gradient block">[ CON DEGRADADO AQUÍ ]</span>
			</h1>

			<!-- Subtítulo -->
			<p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-white/70 sm:text-lg lg:mx-0">
				[ INSERTAR SUBTÍTULO / DESCRIPCIÓN BREVE AQUÍ. Cuéntale a tus visitantes qué hace Nexus Code
				y por qué deberían elegirte. ]
			</p>

			<!-- CTAs -->
			<div class="mt-9 flex flex-col items-center gap-4 sm:flex-row sm:justify-center lg:justify-start">
				<a
					href="#contacto"
					class="group inline-flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#372eab] to-[#8055da] px-7 py-3.5 text-sm font-semibold text-white shadow-glow-sm transition-all duration-300 hover:-translate-y-0.5 hover:shadow-glow hover:brightness-110 sm:w-auto"
				>
					[ CTA PRINCIPAL ]
					<svg class="size-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5-5 5M6 12h12"></path>
					</svg>
				</a>
				<a
					href="#proyectos"
					class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-white/15 bg-white/5 px-7 py-3.5 text-sm font-semibold text-white backdrop-blur transition-all duration-300 hover:-translate-y-0.5 hover:border-[#8055da]/70 hover:bg-[#8055da]/10 hover:shadow-[0_0_22px_-6px_rgba(128,85,218,0.8)] sm:w-auto"
				>
					[ CTA SECUNDARIO ]
				</a>
			</div>

			<!-- Métricas placeholder -->
			<div class="mt-12 grid max-w-lg grid-cols-3 gap-4 text-center lg:text-left">
				<div>
					<p class="font-display text-2xl font-bold text-white sm:text-3xl">[ 00+ ]</p>
					<p class="mt-1 text-xs text-white/50">[ PROYECTOS ]</p>
				</div>
				<div class="border-x border-white/10 px-2">
					<p class="font-display text-2xl font-bold text-white sm:text-3xl">[ 00+ ]</p>
					<p class="mt-1 text-xs text-white/50">[ CLIENTES ]</p>
				</div>
				<div>
					<p class="font-display text-2xl font-bold text-white sm:text-3xl">[ 00 ]</p>
					<p class="mt-1 text-xs text-white/50">[ AÑOS ]</p>
				</div>
			</div>
		</div>

		<!-- ===== Espacio visual: maqueta / dashboard placeholder ===== -->
		<div class="relative mx-auto w-full max-w-xl animate-float-slow">
			<div class="border-gradient rounded-2xl p-px shadow-glow transition-all duration-300">
				<div class="overflow-hidden rounded-2xl bg-[#010715]">
					<!-- Barra superior de la ventana -->
					<div class="flex items-center gap-2 border-b border-white/5 bg-white/5 px-4 py-3">
						<span class="size-2.5 rounded-full bg-[#ff5f57]"></span>
						<span class="size-2.5 rounded-full bg-[#febc2e]"></span>
						<span class="size-2.5 rounded-full bg-[#28c840]"></span>
						<span class="ml-3 text-xs text-white/40">[ app.nexuscode.dev ]</span>
					</div>

					<!-- Contenido de la maqueta -->
					<div class="space-y-4 p-5 sm:p-6">
						<div class="flex items-center justify-between">
							<div class="h-3 w-28 rounded-full bg-gradient-to-r from-[#372eab] to-[#8055da]"></div>
							<div class="h-3 w-16 rounded-full bg-white/10"></div>
						</div>
						<div class="grid grid-cols-3 gap-3">
							<div class="rounded-lg border border-white/5 bg-white/5 p-3">
								<div class="mb-2 h-2 w-8 rounded-full bg-white/20"></div>
								<div class="h-4 w-12 rounded bg-gradient-to-r from-[#372eab] to-[#8055da]"></div>
							</div>
							<div class="rounded-lg border border-white/5 bg-white/5 p-3">
								<div class="mb-2 h-2 w-8 rounded-full bg-white/20"></div>
								<div class="h-4 w-12 rounded bg-white/15"></div>
							</div>
							<div class="rounded-lg border border-white/5 bg-white/5 p-3">
								<div class="mb-2 h-2 w-8 rounded-full bg-white/20"></div>
								<div class="h-4 w-12 rounded bg-white/15"></div>
							</div>
						</div>
						<!-- Gráfico simulado -->
						<div class="flex h-32 items-end gap-2 rounded-lg border border-white/5 bg-white/[0.03] p-4">
							<div class="w-full rounded-t bg-gradient-to-t from-[#372eab]/70 to-[#8055da]/70" style="height: 35%"></div>
							<div class="w-full rounded-t bg-gradient-to-t from-[#372eab]/70 to-[#8055da]/70" style="height: 55%"></div>
							<div class="w-full rounded-t bg-gradient-to-t from-[#372eab]/70 to-[#8055da]/70" style="height: 42%"></div>
							<div class="w-full rounded-t bg-gradient-to-t from-[#372eab]/70 to-[#8055da]/70" style="height: 78%"></div>
							<div class="w-full rounded-t bg-gradient-to-t from-[#372eab]/70 to-[#8055da]/70" style="height: 60%"></div>
							<div class="w-full rounded-t bg-gradient-to-t from-[#372eab]/70 to-[#8055da]/70" style="height: 92%"></div>
						</div>
						<div class="rounded-lg border border-white/5 bg-white/[0.03] p-4">
							<div class="mb-3 h-2 w-24 rounded-full bg-white/15"></div>
							<div class="mb-2 h-2 w-full rounded-full bg-white/10"></div>
							<div class="h-2 w-3/4 rounded-full bg-gradient-to-r from-[#372eab] to-[#8055da]"></div>
						</div>
					</div>
				</div>
			</div>

			<!-- Etiqueta flotante sobre la maqueta -->
			<div
				class="absolute -top-5 -right-3 rounded-lg border border-[#8055da]/40 bg-[#010715]/90 px-3 py-1.5 text-xs text-white/80 backdrop-blur animate-pulse-glow sm:-right-6"
			>
				[ ELEMENTO INTERACTIVO ]
			</div>
		</div>
	</div>
</section>

