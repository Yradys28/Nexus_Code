---
// Valores / enfoque de trabajo — personaliza los ítems
const values = [
	{ title: '[ VALOR 1 ]', desc: '[ DESCRIPCIÓN DEL VALOR 1 ]' },
	{ title: '[ VALOR 2 ]', desc: '[ DESCRIPCIÓN DEL VALOR 2 ]' },
	{ title: '[ VALOR 3 ]', desc: '[ DESCRIPCIÓN DEL VALOR 3 ]' },
];
---

<section id="sobre-nosotros" class="relative scroll-mt-20 py-20 sm:py-24">
	<div
		class="pointer-events-none absolute right-0 bottom-1/4 h-96 w-96 rounded-full bg-[#8055da]/15 blur-[130px]"
		aria-hidden="true"
	></div>

	<div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
			<!-- ===== Columna 1: texto ===== -->
			<div class="reveal">
				<span
					class="inline-flex items-center gap-2 rounded-full border border-[#8055da]/40 bg-[#8055da]/10 px-4 py-1.5 text-xs font-medium tracking-wide text-white/80 backdrop-blur transition-all duration-300 hover:border-[#8055da] hover:shadow-[0_0_20px_-4px_rgba(128,85,218,0.7)]"
				>
					[ BADGE SECCIÓN ]
				</span>
				<h2 class="font-display mt-5 text-3xl font-bold tracking-tight text-white sm:text-4xl">
					[ TÍTULO DE LA SECCIÓN ]
					<span class="text-gradient">[ SOBRE NOSOTROS ]</span>
				</h2>

				<p class="mt-5 leading-relaxed text-white/70">
					[ INSERTAR HISTORIA / QUIÉNES SOMOS AQUÍ. Cuénta la historia de la empresa, su misión y
					cómo nació Nexus Code. ]
				</p>
				<p class="mt-4 leading-relaxed text-white/70">
					[ INSERTAR ENFOQUE DE TRABAJO AQUÍ. Describe cómo trabajan, metodologías, tecnología
					favorita o cualquier detalle que los diferencie. ]
				</p>

				<!-- Valores / puntos clave -->
				<div class="mt-8 space-y-4">
					{
						values.map((value) => (
							<div class="group flex items-start gap-3 rounded-xl border border-white/10 bg-white/[0.03] p-4 transition-all duration-300 hover:border-[#8055da]/60 hover:bg-[#8055da]/5 hover:shadow-[0_0_22px_-8px_rgba(128,85,218,0.7)]">
								<span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-md bg-gradient-to-br from-[#372eab] to-[#8055da] text-xs font-bold text-white">
									✓
								</span>
								<div>
									<h3 class="text-sm font-semibold text-white">{value.title}</h3>
									<p class="mt-1 text-sm text-white/60">{value.desc}</p>
								</div>
							</div>
						))
					}
				</div>
			</div>

			<!-- ===== Columna 2: imagen / gráfico placeholder ===== -->
			<div class="reveal relative">
				<div class="border-gradient rounded-2xl p-px shadow-glow">
					<div class="relative aspect-[4/3] overflow-hidden rounded-2xl bg-white/[0.04]">
						<div class="absolute inset-0 flex flex-col items-center justify-center gap-2 text-center">
							<span class="text-sm font-semibold tracking-widest text-white/60">
								[ INSERTAR IMAGEN / GRÁFICO ]
							</span>
							<span class="text-xs text-white/40">[ EQUIPO, OFICINA O DIAGRAMA ]</span>
						</div>
						<!-- Rejilla decorativa sobre el placeholder -->
						<div class="bg-grid pointer-events-none absolute inset-0 opacity-50" aria-hidden="true"></div>
					</div>
				</div>

				<!-- Tarjeta flotante de dato destacado -->
				<div
					class="animate-float-slow absolute -bottom-6 -left-4 rounded-xl border border-[#8055da]/40 bg-[#010715]/90 p-4 shadow-glow-sm backdrop-blur sm:-left-8"
				>
					<p class="font-display text-2xl font-bold text-gradient">[ 00+ ]</p>
					<p class="mt-0.5 text-xs text-white/60">[ DATO DESTACADO ]</p>
				</div>
			</div>
		</div>
	</div>
</section>
