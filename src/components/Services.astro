---
// Grid de servicios — reemplaza textos/iconos con contenido real
const services = [
	{ icon: '[ ÍCONO / SERVICIO 1 ]', title: '[ TÍTULO SERVICIO 1 ]', desc: '[ DESCRIPCIÓN CORTA DEL SERVICIO 1. Explica brevemente qué ofreces y cómo resuelves el problema del cliente. ]' },
	{ icon: '[ ÍCONO / SERVICIO 2 ]', title: '[ TÍTULO SERVICIO 2 ]', desc: '[ DESCRIPCIÓN CORTA DEL SERVICIO 2. Explica brevemente qué ofreces y cómo resuelves el problema del cliente. ]' },
	{ icon: '[ ÍCONO / SERVICIO 3 ]', title: '[ TÍTULO SERVICIO 3 ]', desc: '[ DESCRIPCIÓN CORTA DEL SERVICIO 3. Explica brevemente qué ofreces y cómo resuelves el problema del cliente. ]' },
	{ icon: '[ ÍCONO / SERVICIO 4 ]', title: '[ TÍTULO SERVICIO 4 ]', desc: '[ DESCRIPCIÓN CORTA DEL SERVICIO 4. Explica brevemente qué ofreces y cómo resuelves el problema del cliente. ]' },
];
---

<section id="servicios" class="relative scroll-mt-20 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<!-- Encabezado de sección -->
		<div class="reveal mx-auto max-w-2xl text-center">
			<span
				class="inline-flex items-center gap-2 rounded-full border border-[#8055da]/40 bg-[#8055da]/10 px-4 py-1.5 text-xs font-medium tracking-wide text-white/80 backdrop-blur transition-all duration-300 hover:border-[#8055da] hover:shadow-[0_0_20px_-4px_rgba(128,85,218,0.7)]"
			>
				[ BADGE SECCIÓN ]
			</span>
			<h2 class="font-display mt-5 text-3xl font-bold tracking-tight text-white sm:text-4xl">
				[ TÍTULO DE LA SECCIÓN ]
				<span class="text-gradient">[ SERVICIOS ]</span>
			</h2>
			<p class="mt-4 text-white/70">
				[ DESCRIPCIÓN DE LA SECCIÓN: una o dos frases sobre lo que hacemos en Nexus Code. ]
			</p>
		</div>

		<!-- Grid de tarjetas -->
		<div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
			{
				services.map((service, i) => (
					<article
						class="group relative reveal overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] p-6 backdrop-blur transition-all duration-300 hover:-translate-y-1.5 hover:border-[#8055da]/60 hover:shadow-[0_0_30px_-8px_rgba(128,85,218,0.7)]"
						style={`transition-delay: ${i * 80}ms`}
					>
						{/* Brillo interior al hacer hover */}
						<div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-[#372eab]/0 via-[#8055da]/0 to-[#8055da]/0 transition-all duration-300 group-hover:from-[#372eab]/10 group-hover:to-[#8055da]/10" />

						{/* Icono / placeholder */}
						<div class="relative mb-5 inline-flex size-14 items-center justify-center rounded-xl bg-gradient-to-br from-[#372eab] to-[#8055da] text-sm font-semibold text-white shadow-glow-sm transition-all duration-300 group-hover:shadow-glow">
							{service.icon}
						</div>

						<h3 class="font-display relative text-lg font-semibold text-white transition-colors duration-300 group-hover:text-[#c4b5fd]">
							{service.title}
						</h3>
						<p class="relative mt-3 text-sm leading-relaxed text-white/60">
							{service.desc}
						</p>

						{/* Línea de acento inferior que crece al hover */}
						<div class="absolute bottom-0 left-0 h-0.5 w-0 bg-gradient-to-r from-[#372eab] to-[#8055da] transition-all duration-500 group-hover:w-full" />
					</article>
				))
			}
		</div>
	</div>
</section>
