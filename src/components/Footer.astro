---
// Links rápidos y redes sociales del footer
const quickLinks = [
	{ label: 'Inicio', href: '#inicio' },
	{ label: 'Servicios', href: '#servicios' },
	{ label: 'Proyectos', href: '#proyectos' },
	{ label: 'Sobre Nosotros', href: '#sobre-nosotros' },
	{ label: 'Contacto', href: '#contacto' },
];

const socials = [
	{ label: '[ GITHUB ]', icon: 'GH', href: '#' },
	{ label: '[ LINKEDIN ]', icon: 'IN', href: '#' },
	{ label: '[ X / TWITTER ]', icon: 'X', href: '#' },
	{ label: '[ INSTAGRAM ]', icon: 'IG', href: '#' },
];

const currentYear = new Date().getFullYear();
---

<footer class="relative border-t border-white/5 bg-[#010715]">
	<!-- Línea superior con degradado -->
	<div class="absolute top-0 left-0 h-px w-full bg-gradient-to-r from-transparent via-[#8055da] to-transparent opacity-60"></div>

	<div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
		<div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
			<!-- Marca -->
			<div class="lg:col-span-2">
				<a href="#inicio" class="inline-flex items-center gap-2 text-sm font-bold tracking-widest">
					<span class="inline-block size-2.5 rounded-full bg-gradient-to-r from-[#372eab] to-[#8055da] shadow-[0_0_10px_rgba(128,85,218,0.8)]"></span>
					<span class="font-display text-white">[ LOGO NEXUS CODE ]</span>
				</a>
				<p class="mt-4 max-w-md text-sm leading-relaxed text-white/60">
					[ INSERTAR DESCRIPCIÓN BREVE DE LA EMPRESA AQUÍ: quiénes somos, qué hacemos y qué nos
					hace diferentes. ]
				</p>
				<!-- Redes sociales -->
				<div class="mt-6 flex flex-wrap gap-3">
					{
						socials.map((social) => (
							<a
								href={social.href}
								aria-label={social.label}
								class="inline-flex size-10 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-xs font-semibold text-white/70 transition-all duration-300 hover:-translate-y-0.5 hover:border-[#8055da]/70 hover:bg-[#8055da]/15 hover:text-white hover:shadow-[0_0_18px_-6px_rgba(128,85,218,0.9)]"
							>
								{social.icon}
							</a>
						))
					}
				</div>
			</div>

			<!-- Links rápidos -->
			<div>
				<h3 class="font-display text-sm font-semibold tracking-wide text-white">[ ENLACES RÁPIDOS ]</h3>
				<ul class="mt-4 space-y-2.5">
					{
						quickLinks.map((link) => (
							<li>
								<a
									href={link.href}
									class="text-sm text-white/60 transition-all duration-300 hover:translate-x-1 hover:text-white"
								>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<!-- Contacto rápido -->
			<div>
				<h3 class="font-display text-sm font-semibold tracking-wide text-white">[ CONTACTO ]</h3>
				<ul class="mt-4 space-y-2.5 text-sm text-white/60">
					<li class="transition-colors duration-300 hover:text-white">[ hola@nexuscode.com ]</li>
					<li class="transition-colors duration-300 hover:text-white">[ +00 000 000 000 ]</li>
					<li class="transition-colors duration-300 hover:text-white">[ CIUDAD, PAÍS ]</li>
				</ul>
			</div>
		</div>

		<!-- Barra inferior -->
		<div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 sm:flex-row">
			<p class="text-xs text-white/50">
				© {currentYear} [ NEXUS CODE ]. [ TODOS LOS DERECHOS RESERVADOS ].
			</p>
			<p class="text-xs text-white/40">
				[ HECHO CON ♥ POR NEXUS CODE ]
			</p>
		</div>
	</div>
</footer>
