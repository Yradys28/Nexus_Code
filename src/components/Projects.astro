---
// Grid de proyectos del portafolio
const projects = [
	{
		title: '[ TÍTULO DEL PROYECTO 1 ]',
		desc: '[ DESCRIPCIÓN DEL PROYECTO. Problema que resuelve, alcance y resultado obtenido. ]',
		stack: ['React', 'Astro', 'Tailwind'],
	},
	{
		title: '[ TÍTULO DEL PROYECTO 2 ]',
		desc: '[ DESCRIPCIÓN DEL PROYECTO. Problema que resuelve, alcance y resultado obtenido. ]',
		stack: ['Node.js', 'Express', 'MongoDB'],
	},
	{
		title: '[ TÍTULO DEL PROYECTO 3 ]',
		desc: '[ DESCRIPCIÓN DEL PROYECTO. Problema que resuelve, alcance y resultado obtenido. ]',
		stack: ['Astro', 'TypeScript', 'Tailwind'],
	},
	{
		title: '[ TÍTULO DEL PROYECTO 4 ]',
		desc: '[ DESCRIPCIÓN DEL PROYECTO. Problema que resuelve, alcance y resultado obtenido. ]',
		stack: ['React', 'Node.js', 'PostgreSQL'],
	},
];
---

<section id="proyectos" class="relative scroll-mt-20 py-20 sm:py-24">
	<!-- Sutil resplandor de fondo -->
	<div
		class="pointer-events-none absolute top-1/3 left-0 h-96 w-96 rounded-full bg-[#372eab]/15 blur-[130px]"
		aria-hidden="true"
	></div>

	<div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<!-- Encabezado de sección -->
		<div class="reveal mx-auto max-w-2xl text-center">
			<span
				class="inline-flex items-center gap-2 rounded-full border border-[#8055da]/40 bg-[#8055da]/10 px-4 py-1.5 text-xs font-medium tracking-wide text-white/80 backdrop-blur transition-all duration-300 hover:border-[#8055da] hover:shadow-[0_0_20px_-4px_rgba(128,85,218,0.7)]"
			>
				[ BADGE SECCIÓN ]
			</span>
			<h2 class="font-display mt-5 text-3xl font-bold tracking-tight text-white sm:text-4xl">
				[ TÍTULO DE LA SECCIÓN ]
				<span class="text-gradient">[ PORTAFOLIO ]</span>
			</h2>
			<p class="mt-4 text-white/70">
				[ DESCRIPCIÓN DE LA SECCIÓN: una o dos frases sobre los proyectos destacados. ]
			</p>
		</div>

		<!-- Grid de proyectos -->
		<div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-2 xl:gap-8">
			{
				projects.map((project, i) => (
					<article
						class="group reveal overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] backdrop-blur transition-all duration-300 hover:-translate-y-1.5 hover:border-[#8055da]/60 hover:shadow-[0_0_34px_-10px_rgba(128,85,218,0.75)]"
						style={`transition-delay: ${i * 80}ms`}
					>
						{/* Recuadro placeholder para la imagen */}
						<div class="relative aspect-video overflow-hidden border-b border-white/10 bg-gradient-to-br from-white/10 to-white/5">
							<div class="absolute inset-0 flex flex-col items-center justify-center gap-2 text-center">
								<span class="text-xs font-semibold tracking-widest text-white/60">
									[ INSERTAR IMAGEN ]
								</span>
								<span class="text-[10px] text-white/40">[ CAPTURA DEL PROYECTO ]</span>
							</div>
							{/* Overlay de acento al hover */}
							<div class="absolute inset-0 bg-gradient-to-r from-[#372eab]/40 to-[#8055da]/40 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
						</div>

						<div class="p-5 sm:p-6">
							<h3 class="font-display text-lg font-semibold text-white transition-colors duration-300 group-hover:text-[#c4b5fd]">
								{project.title}
							</h3>
							<p class="mt-2 text-sm leading-relaxed text-white/60">{project.desc}</p>

							{/* Badges del tech stack */}
							<div class="mt-4 flex flex-wrap gap-2">
								{project.stack.map((tech) => (
									<span class="rounded-full border border-[#8055da]/30 bg-[#8055da]/10 px-2.5 py-0.5 text-[11px] font-medium text-white/80 transition-all duration-300 group-hover:border-[#8055da]/60">
										{tech}
									</span>
								))}
							</div>

							{/* Acciones */}
							<div class="mt-5 flex gap-3">
								<a
									href="#"
									class="inline-flex flex-1 items-center justify-center gap-1.5 rounded-lg bg-gradient-to-r from-[#372eab] to-[#8055da] px-4 py-2.5 text-xs font-semibold text-white transition-all duration-300 hover:brightness-110 hover:shadow-glow-sm"
								>
									[ VER DEMO ]
								</a>
								<a
									href="#"
									class="inline-flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-white/15 bg-white/5 px-4 py-2.5 text-xs font-semibold text-white transition-all duration-300 hover:border-[#8055da]/70 hover:bg-[#8055da]/10"
								>
									[ CÓDIGO ]
								</a>
							</div>
						</div>
					</article>
				))
			}
		</div>

		<!-- CTA ver más -->
		<div class="reveal mt-12 text-center">
			<a
				href="#"
				class="inline-flex items-center gap-2 rounded-xl border border-white/15 bg-white/5 px-7 py-3.5 text-sm font-semibold text-white backdrop-blur transition-all duration-300 hover:-translate-y-0.5 hover:border-[#8055da]/70 hover:bg-[#8055da]/10 hover:shadow-[0_0_22px_-6px_rgba(128,85,218,0.8)]"
			>
				[ VER TODOS LOS PROYECTOS ]
			</a>
		</div>
	</div>
</section>
