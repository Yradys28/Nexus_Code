---
// Tarjetas de contacto directo
const directContacts = [
	{ label: '[ WHATSAPP ]', value: '[ +00 000 000 000 ]', href: '#' },
	{ label: '[ EMAIL ]', value: '[ hola@nexuscode.com ]', href: 'mailto:hola@nexuscode.com' },
];
---

<section id="contacto" class="relative scroll-mt-20 py-20 sm:py-24">
	<div
		class="pointer-events-none absolute top-0 left-1/2 h-[400px] w-[640px] -translate-x-1/2 rounded-full bg-[#372eab]/25 blur-[130px]"
		aria-hidden="true"
	></div>

	<div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<!-- Encabezado de sección -->
		<div class="reveal mx-auto max-w-2xl text-center">
			<span
				class="inline-flex items-center gap-2 rounded-full border border-[#8055da]/40 bg-[#8055da]/10 px-4 py-1.5 text-xs font-medium tracking-wide text-white/80 backdrop-blur transition-all duration-300 hover:border-[#8055da] hover:shadow-[0_0_20px_-4px_rgba(128,85,218,0.7)]"
			>
				[ BADGE SECCIÓN ]
			</span>
			<h2 class="font-display mt-5 text-3xl font-bold tracking-tight text-white sm:text-4xl">
				[ TÍTULO DE LA SECCIÓN ]
				<span class="text-gradient">[ CONTACTO ]</span>
			</h2>
			<p class="mt-4 text-white/70">
				[ DESCRIPCIÓN: cuéntanos tu proyecto y te responderemos lo antes posible. ]
			</p>
		</div>

		<div class="mt-14 grid gap-8 lg:grid-cols-5 lg:gap-10">
			<!-- ===== Formulario ===== -->
			<div class="reveal lg:col-span-3">
				<form class="border-gradient rounded-2xl p-px shadow-glow-sm">
					<div class="space-y-5 rounded-2xl bg-[#010715] p-6 sm:p-8">
						<div class="grid gap-5 sm:grid-cols-2">
							<!-- Nombre -->
							<div>
								<label for="name" class="mb-1.5 block text-sm font-medium text-white/80">
									[ NOMBRE ]
								</label>
								<input
									type="text"
									id="name"
									name="name"
									placeholder="[ Tu nombre ]"
									required
									class="w-full rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder-white/40 outline-none backdrop-blur transition-all duration-300 focus:border-[#8055da] focus:bg-[#8055da]/5 focus:shadow-[0_0_18px_-6px_rgba(128,85,218,0.9)]"
								/>
							</div>
							<!-- Email -->
							<div>
								<label for="email" class="mb-1.5 block text-sm font-medium text-white/80">
									[ EMAIL ]
								</label>
								<input
									type="email"
									id="email"
									name="email"
									placeholder="[ tu@email.com ]"
									required
									class="w-full rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder-white/40 outline-none backdrop-blur transition-all duration-300 focus:border-[#8055da] focus:bg-[#8055da]/5 focus:shadow-[0_0_18px_-6px_rgba(128,85,218,0.9)]"
								/>
							</div>
						</div>
						<!-- Mensaje -->
						<div>
							<label for="message" class="mb-1.5 block text-sm font-medium text-white/80">
								[ MENSAJE ]
							</label>
							<textarea
								id="message"
								name="message"
								rows="5"
								placeholder="[ Cuéntanos sobre tu proyecto... ]"
								required
								class="w-full resize-y rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder-white/40 outline-none backdrop-blur transition-all duration-300 focus:border-[#8055da] focus:bg-[#8055da]/5 focus:shadow-[0_0_18px_-6px_rgba(128,85,218,0.9)]"
							></textarea>
						</div>
						<!-- Envío -->
						<button
							type="submit"
							class="group inline-flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#372eab] to-[#8055da] px-7 py-3.5 text-sm font-semibold text-white shadow-glow-sm transition-all duration-300 hover:-translate-y-0.5 hover:shadow-glow hover:brightness-110"
						>
							[ ENVIAR MENSAJE ]
							<svg class="size-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.27 3.96A59.77 59.77 0 0121.49 12 59.77 59.77 0 013.27 20.04L6 12zm0 0h7.5"></path>
							</svg>
						</button>
					</div>
				</form>
			</div>

			<!-- ===== Tarjetas de contacto directo ===== -->
			<div class="space-y-5 lg:col-span-2">
				{
					directContacts.map((contact) => (
						<a
							href={contact.href}
							class="group reveal flex items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.03] p-5 backdrop-blur transition-all duration-300 hover:-translate-y-1 hover:border-[#8055da]/60 hover:shadow-[0_0_28px_-8px_rgba(128,85,218,0.75)]"
						>
							<span class="inline-flex size-12 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-[#372eab] to-[#8055da] shadow-glow-sm transition-all duration-300 group-hover:shadow-glow">
								[ Í ]
							</span>
							<span>
								<span class="block text-xs tracking-widest text-white/50">{contact.label}</span>
								<span class="block font-medium text-white transition-colors duration-300 group-hover:text-[#c4b5fd]">
									{contact.value}
								</span>
							</span>
						</a>
					))
				}

				<!-- Info extra -->
				<div
					class="reveal rounded-2xl border border-white/10 bg-white/[0.03] p-5 backdrop-blur transition-all duration-300 hover:border-[#8055da]/40"
				>
					<h3 class="font-display text-sm font-semibold text-white">[ HORARIO / UBICACIÓN ]</h3>
					<p class="mt-2 text-sm leading-relaxed text-white/60">
						[ INSERTAR INFORMACIÓN ADICIONAL: horario de atención, ubicación o redes directas. ]
					</p>
				</div>
			</div>
		</div>
	</div>
</section>
